{
  "name": "antigravity-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready monorepo with Web (React/Vite), Mobile (Expo), FastAPI Backend, and MongoDB",
  "workspaces": [
    "packages/shared",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:mobile:tunnel": "npm run tunnel --workspace=mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:web": "npm run build --workspace=web",
    "test:backend": "cd backend && pytest -v"
  },
  "keywords": [
    "monorepo",
    "fastapi",
    "mongodb",
    "react",
    "react-native",
    "expo"
  ],
  "author": "",
  "license": "MIT"
}
